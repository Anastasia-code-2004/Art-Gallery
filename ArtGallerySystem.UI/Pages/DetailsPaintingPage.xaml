<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.DetailsPaintingPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="models:DetailsPaintingViewModel"
             Title="Painting">
    <ContentPage.Resources>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="TitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"  
                                        Command="{Binding UpdateInfoCommand}"/>
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame HasShadow="True" CornerRadius="10">
                <Image Source="{Binding SelectedPhoto}" 
                       Aspect="AspectFit" WidthRequest="500" HeightRequest="250"/>
            </Frame>

            <Label Text="{Binding Painting.Name}" Style="{StaticResource TitleLabelStyle}"/>
            <Label Text="{Binding Painting.Author}" Style="{StaticResource LabelStyle}"/>
            <Label Text="{Binding Painting.YearOfCreation}" Style="{StaticResource LabelStyle}"/>

            <!-- Добавление разделителя -->
            <BoxView HeightRequest="1" BackgroundColor="Gray" Opacity="0.5"/>

            <!-- Пример дополнительных данных -->
            <Label Text="Additional Information" Style="{StaticResource TitleLabelStyle}"/>
            <Label  Text="{Binding Painting.Description}" Style="{StaticResource LabelStyle}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
