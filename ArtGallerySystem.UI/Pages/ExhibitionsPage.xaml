<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.ExhibitionsPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:entities="clr-namespace:ArtGallerySystem.Domain.Entities;assembly=ArtGallerySystem.Domain"
             x:DataType="models:ExhibitionsViewModel"
             Title="Exhibitions">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"  
                                        Command="{Binding UpdateExhibitionsCommand}"/>
    </ContentPage.Behaviors>

    <CollectionView ItemsSource="{Binding Exhibitions}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="entities:Exhibition">
                <Frame Padding="15" Margin="10" BorderColor="#FFB6C1" BackgroundColor="#FFF0F5" CornerRadius="10" HasShadow="True">
                    <StackLayout>
                        <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" TextColor="#C71585"/>
                        <Label Text="{Binding Description}" FontSize="16" TextColor="#555555"/>
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Label Text="{Binding StartDate, StringFormat='Start: {0:dd/MM/yyyy}'}" FontSize="14" TextColor="#696969"/>
                            <Label Text="{Binding EndDate, StringFormat='End: {0:dd/MM/yyyy}'}" FontSize="14" TextColor="#696969"/>
                        </StackLayout>
                        <Label Text="{Binding TicketPrice, StringFormat='Price: {0:N2} BYN'}" FontSize="16" FontAttributes="Italic" TextColor="#DB7093"/>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type models:ExhibitionsViewModel}}, Path=ViewExhibitionCommand}" 
                                              CommandParameter="{Binding}"/>
                    </Frame.GestureRecognizers>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
