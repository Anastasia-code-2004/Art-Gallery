<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.DetailsExhibitionPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:entities="clr-namespace:ArtGallerySystem.Domain.Entities;assembly=ArtGallerySystem.Domain"
             x:DataType="models:DetailsExhibitionViewModel"
             xmlns:valueConverters="clr-namespace:ArtGallerySystem.UI.ValueConverters"
             Title="Paintings">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Buy Ticket" CommandParameter="{Binding Exhibition.Id}"
                     Command="{Binding BuyTicketCommand}"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <Style x:Key="PhotoItemStyle" TargetType="StackLayout">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Spacing" Value="5"/>
        </Style>

        <Style x:Key="TitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Medium"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style x:Key="DescriptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Small"/>
            <Setter Property="TextColor" Value="Gray"/>
        </Style>
        <ResourceDictionary>
            <valueConverters:BytesToImageSourceConverter x:Key="BytesToImageSourceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"  
                                        Command="{Binding UpdatePaintingsCommand}"/>
    </ContentPage.Behaviors>
    <CollectionView ItemsSource="{Binding Paintings}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="entities:Painting">
                <StackLayout Style="{StaticResource PhotoItemStyle}">
                    <Image Source="{Binding Photo, Converter={StaticResource BytesToImageSourceConverter}}" Aspect="AspectFit" WidthRequest="200" HeightRequest="300">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type models:DetailsExhibitionViewModel}}, Path=DetailsPaintingCommand}" 
                                                  CommandParameter="{Binding .}"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Text="{Binding Name}" Style="{StaticResource TitleStyle}" />
                    <Label Text="{Binding Description}" Style="{StaticResource DescriptionStyle}" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
