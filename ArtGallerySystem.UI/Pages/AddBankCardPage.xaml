<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.AddBankCardPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="models:AddBankCardViewModel"
             Title="Add Bank Card">

    <ContentPage.Resources>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#333333" />
            <Setter Property="FontSize" Value="Medium" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="EntryFrameStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,5,0,10" />
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="BorderColor" Value="#ffcad4" />
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="#333333" />
            <Setter Property="PlaceholderColor" Value="#999999" />
            <Setter Property="FontSize" Value="Medium" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#ffcad4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="Medium" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
    </ContentPage.Resources>

    <StackLayout Padding="20">
        <Label Text="Card Number" Style="{StaticResource LabelStyle}" />
        <Frame Style="{StaticResource EntryFrameStyle}">
            <Entry Placeholder="Enter card number" 
                   Text="{Binding CardNumber}"
                   Keyboard="Numeric"
                   MaxLength="16"
                   Style="{StaticResource EntryStyle}" />
        </Frame>

        <Label Text="Expiration Date (MM/YY)" Style="{StaticResource LabelStyle}" />
        <Frame Style="{StaticResource EntryFrameStyle}">
            <Entry Placeholder="MM/YY" 
                   Text="{Binding ExpirationDate}"
                   MaxLength="5"
                   Style="{StaticResource EntryStyle}" />
        </Frame>

        <Label Text="CVV Code" Style="{StaticResource LabelStyle}" />
        <Frame Style="{StaticResource EntryFrameStyle}">
            <Entry Placeholder="Enter CVV code" 
                   Text="{Binding Cvv}" 
                   Keyboard="Numeric"
                   IsPassword="True"
                   MaxLength="4"
                   Style="{StaticResource EntryStyle}" />
        </Frame>

        <Button Text="Add" Style="{StaticResource ButtonStyle}">
            <Button.Behaviors>
                <toolkit:EventToCommandBehavior EventName="Clicked" Command="{Binding AddBankCardCommand}"/>
            </Button.Behaviors>
        </Button>
    </StackLayout>

</ContentPage>
