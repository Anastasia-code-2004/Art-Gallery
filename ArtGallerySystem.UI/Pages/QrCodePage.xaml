<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.QrCodePage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:helpers="clr-namespace:ArtGallerySystem.UI.Helpers"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="models:QrCodeViewModel"
             Title="QR Codes">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"
                                        Command="{Binding UpdateQrCodesCommand}" />
    </ContentPage.Behaviors>
    <CollectionView ItemsSource="{Binding QrCodes}"
                    ItemsLayout="VerticalGrid, 2"
                    Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="helpers:QrCodeWithExhibition">
                <Frame Padding="10"
                       Margin="10"
                       BorderColor="LightGray"
                       CornerRadius="10"
                       BackgroundColor="LightBlue"
                       HasShadow="True">
                    <StackLayout>
                        <Image Source="{Binding QrCode}" 
                               HeightRequest="100" 
                               WidthRequest="100" 
                               Aspect="AspectFit" />
                        <Label Text="{Binding ExhibitionName}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               Margin="5,0,5,5" />
                        <Label Text="This QR code has already been used."
                               FontSize="14" 
                               TextColor="Red"
                               HorizontalOptions="Center"
                               Margin="5,0,5,5">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsUsed}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsUsed}"
                                             Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
