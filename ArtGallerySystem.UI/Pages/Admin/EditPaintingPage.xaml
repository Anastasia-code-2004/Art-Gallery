<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.Admin.EditPaintingPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="models:EditPaintingViewModel"
             Title="Edit Painting">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"  
                                        Command="{Binding UpdateInfoCommand}"/>
    </ContentPage.Behaviors>
    <VerticalStackLayout>
        <Image Source="{Binding SelectedPhoto}" 
               Aspect="AspectFit" WidthRequest="500" HeightRequest="250"/>
        <Entry Placeholder="Name" Text="{Binding Painting.Name, Mode=TwoWay}" MaxLength="25" WidthRequest="350"/>
        <Entry Placeholder="Author" Text="{Binding Painting.Author, Mode=TwoWay}" MaxLength="30" WidthRequest="350"/>
        <Entry Placeholder="Year" Text="{Binding Painting.YearOfCreation, Mode=TwoWay}" Keyboard="Numeric" MaxLength="4" WidthRequest="350"/>
        <Editor Placeholder="Description" 
                Text="{Binding Painting.Description, Mode=TwoWay}"
                MaxLength="200" 
                WidthRequest="350" 
                HeightRequest="100"
                VerticalOptions="StartAndExpand" 
                HorizontalOptions="FillAndExpand" />
        <Button Text="Choose Photo" BackgroundColor="#d8e2dc" WidthRequest="350">
            <Button.Behaviors>
                <toolkit:EventToCommandBehavior EventName="Clicked" Command="{Binding ChoosePhotoCommand}"/>
            </Button.Behaviors>
        </Button>
        <Button Text="Save" BackgroundColor="#f4acb7" WidthRequest="350">
            <Button.Behaviors>
                <toolkit:EventToCommandBehavior EventName="Clicked" Command="{Binding EditPaintingCommand}"/>
            </Button.Behaviors>
        </Button>
    </VerticalStackLayout>

</ContentPage>