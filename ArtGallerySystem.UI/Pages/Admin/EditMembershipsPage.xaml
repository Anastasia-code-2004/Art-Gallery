<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtGallerySystem.UI.Pages.Admin.EditMembershipsPage"
             xmlns:models="clr-namespace:ArtGallerySystem.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:entities="clr-namespace:ArtGallerySystem.Domain.Entities;assembly=ArtGallerySystem.Domain"
             x:DataType="models:EditMembershipsViewModel"
             Title="Edit Memberships">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"  
                                    Command="{Binding UpdateMembershipCategoriesCommand}"/>
    </ContentPage.Behaviors>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddMembershipCategoryCommand}" IconImageSource="add.png"/>
        <ToolbarItem Command="{Binding DeleteMembershipCategoryCommand}" 
                 CommandParameter="{Binding SelectedMembershipCategory.Id}"
                 IconImageSource="delete.png"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <CollectionView ItemsSource="{Binding MembershipCategories}"
                    SelectedItem="{Binding SelectedMembershipCategory}"
                    SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:CategoryMembership">
                    <StackLayout Orientation="Vertical" Padding="10">
                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding Description}" FontSize="14"/>
                        <Label Text="{Binding Price, StringFormat='Price: {0:N2} BYN'}" FontSize="14"/>
                        <Label Text="{Binding Duration, StringFormat='Duration: {0} month(s)'}" FontSize="12"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage.Content>
</ContentPage>